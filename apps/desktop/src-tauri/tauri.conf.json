{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Pocket Agent",
  "version": "0.1.0",
  "identifier": "com.pocketagent.desktop",
  "build": {
    "beforeDevCommand": "cd ../web && bun run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "cd ../web && bun run build",
    "frontendDist": "../web/dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "title": "Pocket Agent",
        "width": 1280,
        "height": 800,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
