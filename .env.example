# Auth — all-local: none. Remote / production: google
AUTH_MODE=none

# Google OAuth — same Client ID as apps/web (when AUTH_MODE=google)
# GOOGLE_CLIENT_ID=

# Telegram (required for bot)
TELEGRAM_BOT_TOKEN=
# Comma-separated Telegram user IDs allowed to use the bot
TELEGRAM_ALLOWED_USER_IDS=

# LLM providers (set at least one for cloud routing)
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# NAS root override (optional; defaults to config/paths.yaml)
NAS_ROOT=

# Logging
LOG_LEVEL=INFO
