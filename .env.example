# Telegram (required for bot)
TELEGRAM_BOT_TOKEN=
# Comma-separated Telegram user IDs allowed to use the bot
TELEGRAM_ALLOWED_USER_IDS=

# LLM providers (set at least one for cloud routing)
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# NAS root override (optional; defaults to config/paths.yaml)
NAS_ROOT=

# Logging
LOG_LEVEL=INFO

# HTTP API (web app auth — Supabase JWT secret from project settings)
SUPABASE_JWT_SECRET=
SUPABASE_JWT_AUDIENCE=authenticated
