# Telegram (required for bot)
TELEGRAM_BOT_TOKEN=
# Comma-separated Telegram user IDs allowed to use the bot
TELEGRAM_ALLOWED_USER_IDS=

# LLM providers (set at least one for cloud routing)
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# NAS root override (optional; defaults to config/paths.yaml)
NAS_ROOT=

# Logging
LOG_LEVEL=INFO

# Pocket Node HTTP (pocket-agent serve) — used by API worker proxy / local dev
# POCKET_NODE_URL=http://127.0.0.1:8787

# Legacy: Supabase JWT validation on direct agent HTTP (deprecated — use apps/api worker)
# SUPABASE_JWT_SECRET=
# SUPABASE_JWT_AUDIENCE=authenticated
